generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform"]
}

// --- ELLE.BE.O PLATFORM MODELS ---

enum SubscriptionTier {
  free
  standard
  premium
  tier1
  tier2
  tier3
  tier4
  tier5

  @@schema("platform")
}

enum TenantStatus {
  active
  restricted
  suspended
  churned

  @@schema("platform")
}

enum ConsentStatus {
  granted
  pending
  declined
  withdrawn

  @@schema("platform")
}

enum PromptCategory {
  general
  medical_aesthetics

  @@schema("platform")
}

enum TemplateFormat {
  carousel
  reel
  story
  caption
  tiktok

  @@schema("platform")
}

enum BusinessGoalType {
  attract_new_clients
  fill_quiet_days
  promote_high_margin_service
  build_brand_authority
  client_retention

  @@schema("platform")
}

enum ContentStatus {
  draft
  pending
  processing
  completed
  approved
  scheduled
  published
  blocked
  flagged
  archived
  failed

  @@schema("platform")
}

enum JobState {
  created
  queued
  processing_image
  processing_vision
  building_prompt
  generating_text
  generating_reel
  completed
  failed
  retrying
  blocked
  dead_letter

  @@schema("platform")
}

enum SocialAccountStatus {
  connected
  disconnected
  token_expired
  error

  @@schema("platform")
}

enum PublishStatus {
  pending
  published
  failed
  cancelled

  @@schema("platform")
}

enum ToneRating {
  sounds_like_me
  close_but_not_quite
  doesnt_sound_like_me

  @@schema("platform")
}

enum BrandAesthetic {
  minimalist_clean
  moody_editorial
  bright_playful
  soft_feminine
  bold_luxury

  @@schema("platform")
}

enum BrandTier {
  luxury
  mainstream
  accessible

  @@schema("platform")
}

// --- AGENTIC VIDEO PIPELINE (GROWTH_STUDIO_VIDEO) ---

enum VideoType {
  slideshow
  reels
  ai_clips

  @@schema("platform")
}

enum SceneAssetKind {
  image
  video
  generated_clip
  stock

  @@schema("platform")
}

enum Motion {
  ken_burns
  none
  slide

  @@schema("platform")
}

enum Transition {
  fade
  cut
  slide

  @@schema("platform")
}

enum VideoStatus {
  draft
  in_review
  edited
  rendering
  rendered
  published
  failed

  @@schema("platform")
}

enum CriticStatus {
  pending
  passed
  failed
  revising

  @@schema("platform")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String    @unique @db.VarChar(320)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  role                String    @default("technician") @db.VarChar(50)
  emailVerified       Boolean   @default(false) @map("email_verified")
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  tenant           Tenant?
  refreshTokens    RefreshToken[]
  approvedItems    ContentItem[]  @relation("ApprovedBy")
  resolvedJobs     FailedJob[]    @relation("ResolvedBy")
  technicianVideos VideoPlan[]

  @@index([email])
  @@index([role])
  @@map("users")
  @@schema("platform")
}

model Tenant {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String           @unique @map("user_id") @db.Uuid
  businessName            String           @map("business_name") @db.VarChar(255)
  displayName             String?          @map("display_name") @db.VarChar(255)
  subscriptionTier        SubscriptionTier @default(free) @map("subscription_tier")
  subscriptionStartedAt   DateTime?        @map("subscription_started_at") @db.Timestamptz
  subscriptionExpiresAt   DateTime?        @map("subscription_expires_at") @db.Timestamptz
  status                  TenantStatus     @default(active)
  hasGrowthStudioAccess   Boolean          @default(false) @map("has_growth_studio_access")
  generationRestricted    Boolean          @default(false) @map("generation_restricted")
  generationSuspended     Boolean          @default(false) @map("generation_suspended")
  abuseFlagCount          Int              @default(0) @map("abuse_flag_count")
  lastAbuseFlagAt         DateTime?        @map("last_abuse_flag_at") @db.Timestamptz
  stripeCustomerId        String?          @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId    String?          @map("stripe_subscription_id") @db.VarChar(255)
  appliedStripeSessionIds String[]         @default([]) @map("applied_stripe_session_ids")
  trialGenerationsUsed    Int              @default(0) @map("trial_generations_used")
  planGenerationsTotal    Int              @default(0) @map("plan_generations_total")
  planGenerationsUsed     Int              @default(0) @map("plan_generations_used")
  timezone                String           @default("UTC") @db.VarChar(100)
  locale                  String           @default("en-AU") @db.VarChar(20)
  avatarUrl               String?          @map("avatar_url") @db.VarChar(2000)
  phone                   String?          @db.VarChar(50)
  onboardingCompleted     Boolean          @default(false) @map("onboarding_completed")
  onboardingStep          Int              @default(1) @map("onboarding_step")
  termsAcceptedAt         DateTime?        @map("terms_accepted_at") @db.Timestamptz
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  brandHistory           BrandDNA[]
  brandPillars           BrandPillar[]
  brandGoals             BrandGoal[]
  clients                Client[]
  consentRecords         ConsentRecord[]
  appointments           Appointment[]
  imageAssets            ImageAsset[]
  goldenExamples         GoldenExample[]
  businessGoals          BusinessGoal[]
  generationJobs         GenerationJob[]
  contentItems           ContentItem[]
  videoPlans             VideoPlan[]
  videoPipelineEvents    VideoPipelineEvent[]
  socialAccounts         SocialAccount[]
  scheduledPosts         ScheduledPost[]
  campaigns              Campaign[]
  generationAuditLogs    GenerationAuditLog[]
  generationFingerprints GenerationFingerprint[]
  failedJobs             FailedJob[]
  crmIntegrationConfig   CrmIntegrationConfig?
  notifications          Notification[]
  feedbacks              ContentFeedback[]
  performances           PostPerformance[]
  geminiLabBrandDna      GeminiLabBrandDna?
  geminiLabTemplates     GeminiLabTemplate[]
  geminiLabPosts         GeminiLabPost[]

  @@index([userId])
  @@index([status])
  @@index([subscriptionTier])
  @@map("tenants")
  @@schema("platform")
}

// Singleton row (id = "default") holding the one purchasable plan's price and
// generation allowance. Admin-editable so the business can tune it against
// real OpenAI cost data without a redeploy.
model PlanSettings {
  id                  String   @id @default("default")
  priceUsd            Float    @default(50) @map("price_usd")
  generationsIncluded Int      @default(100) @map("generations_included")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("plan_settings")
  @@schema("platform")
}

// One row per subscription tier — the daily generation/reel allowance for that
// tier. Admin-editable so the business can cap AI cost exposure per plan
// without a redeploy. Rows are self-seeded (see GenerationService.getTierLimits)
// with today's hardcoded defaults on first read of an empty table.
model TierGenerationLimits {
  tier              SubscriptionTier @id
  generationsPerDay Int              @default(5) @map("generations_per_day")
  reelsPerDay       Int              @default(2) @map("reels_per_day")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tier_generation_limits")
  @@schema("platform")
}

model MasterPrompt {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category     PromptCategory
  systemPrompt String         @map("system_prompt") @db.Text
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([category, isActive])
  @@map("master_prompts")
  @@schema("platform")
}

// Structural template library — layout "shape" only (format, slide/zone
// structure, pillar/category tags). Deliberately holds no colour, font, or
// image data: every generated preview and every real generation renders
// this structure through the active tenant's BrandDNA (brandDnaV2 palette/
// typography/moodboard), so the library can never drift out of brand.
model Template {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String         @unique @db.VarChar(255)
  name        String         @db.VarChar(255)
  format      TemplateFormat
  pillar      String?        @db.VarChar(100)
  categories  String[]
  goal        String?        @db.VarChar(100)
  description String?        @db.Text
  slideCount  Int?           @map("slide_count")
  // Ordered array of structural zones, e.g.
  // [{ "order": 1, "type": "photo", "label": "Before" }, { "order": 2, "type": "text", "label": "Technique" }]
  // Zone "type" describes content purpose only (photo/text/quote/cta) — never a colour or font.
  zones       Json?
  // Optional link into layout-templates.config.json's renderer keys, so the
  // generation pipeline can resolve a matching base/textTemplate/decoration
  // for this structural template without duplicating that config here.
  rendererKey String?        @map("renderer_key") @db.VarChar(255)
  sortOrder   Int            @default(0) @map("sort_order")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([format, isActive])
  @@index([pillar])
  @@map("templates")
  @@schema("platform")
}

