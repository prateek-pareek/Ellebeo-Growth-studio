// The Video Plan contract (planVersion 1) — single source of truth for all three
// video types (slideshow/reels/ai_clips). Scenes/audio/captions/branding/compliance
// are kept as one validated JSON blob (mirrors the jobPayload pattern on
// GenerationJob) rather than normalized tables; denormalized columns below exist
// only for querying/indexing. The shared zod schema in
// backend/src/ai/video/video-plan.schema.ts is authoritative for the JSON shape.
model VideoPlan {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  appointmentId   String       @map("appointment_id") @db.Uuid
  clientId        String       @map("client_id") @db.Uuid
  technicianId    String       @map("technician_id") @db.Uuid
  brandDnaId      String       @map("brand_dna_id") @db.Uuid
  generationJobId String?      @map("generation_job_id") @db.Uuid
  contentItemId   String?      @map("content_item_id") @db.Uuid
  planVersion     Int          @default(1) @map("plan_version")
  videoType       VideoType    @map("video_type")
  objective       String?      @db.VarChar(100)
  durationSeconds Int          @map("duration_seconds")
  status          VideoStatus  @default(draft)
  plan            Json
  criticStatus    CriticStatus @default(pending) @map("critic_status")
  criticScore     Float?       @map("critic_score")
  criticRevisions Int          @default(0) @map("critic_revisions")
  renderProvider  String?      @map("render_provider") @db.VarChar(50)
  renderId        String?      @map("render_id") @db.VarChar(255)
  outputUrl       String?      @map("output_url") @db.VarChar(2000)
  errorMessage    String?      @map("error_message") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  appointment   Appointment          @relation(fields: [appointmentId], references: [id])
  client        Client               @relation(fields: [clientId], references: [id])
  technician    User                 @relation(fields: [technicianId], references: [id])
  brandDna      BrandDNA             @relation(fields: [brandDnaId], references: [id])
  generationJob GenerationJob?       @relation(fields: [generationJobId], references: [id])
  contentItem   ContentItem?         @relation(fields: [contentItemId], references: [id])
  events        VideoPipelineEvent[]

  @@index([tenantId, status])
  @@index([appointmentId])
  @@index([renderId])
  @@map("video_plans")
  @@schema("platform")
}

// Phase 9 — observability. One row per lifecycle event or agent call, tied to
// a VideoPlan. Deliberately one table for both "trace every agent call" and
// "emit lifecycle events" from the spec, rather than two — a single
// createdAt-ordered stream is what "a full run is reconstructable from
// persisted traces" actually needs; splitting them would only make
// reconstruction harder.
enum VideoEventType {
  video_started
  plan_drafted
  agent_call
  critic_scored
  revision_requested
  compliance_reviewed
  assets_ready
  render_submitted
  render_completed
  render_failed
  published

  @@schema("platform")
}

model VideoPipelineEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoPlanId String         @map("video_plan_id") @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  eventType   VideoEventType @map("event_type")
