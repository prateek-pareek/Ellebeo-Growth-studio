  payload     Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  videoPlan VideoPlan @relation(fields: [videoPlanId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([videoPlanId, createdAt])
  @@index([tenantId, eventType])
  @@map("video_pipeline_events")
  @@schema("platform")
}

// Phase 9 — backend-persisted feature flags (Phase 0 found the frontend
// stub had no backend table at all). Global rollout percentage, not
// per-tenant overrides — deterministic hash(tenantId) decides which tenants
// are "in" below the percentage threshold, so the same tenant stays
// consistently in/out as the percentage ratchets up during a staged rollout.
model FeatureFlag {
  key               String   @id
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0) @map("rollout_percentage")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("feature_flags")
  @@schema("platform")
}

