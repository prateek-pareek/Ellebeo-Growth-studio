  appointmentId String    @map("appointment_id") @db.Uuid
  crmBookingId  String    @map("crm_booking_id") @db.VarChar(255)
  questionKey   String    @map("question_key") @db.Text
  questionLabel String?   @map("question_label") @db.Text
  answer        String?   @db.Text
  answeredAt    DateTime? @map("answered_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([crmBookingId])
  @@map("appointment_questionnaire_responses")
  @@schema("platform")
}

model CrmIntegrationConfig {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @unique @map("tenant_id") @db.Uuid
  crmSyncEnabled     Boolean   @default(false) @map("crm_sync_enabled")
  autoImportBookings Boolean   @default(false) @map("auto_import_bookings")
  autoMapMedia       Boolean   @default(true) @map("auto_map_media")
  webhookSecret      String?   @map("webhook_secret") @db.VarChar(255)
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("crm_integration_configs")
  @@schema("platform")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress String?   @map("ip_address") @db.Inet
  userAgent String?   @map("user_agent") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("platform")
}

model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String    @db.VarChar(100)
  title         String?   @db.VarChar(255)
  body          String?   @db.Text
  data          Json?
  readAt        DateTime? @map("read_at") @db.Timestamptz
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz
  channelSms    Boolean   @default(false) @map("channel_sms")
  externalPhone String?   @map("external_phone") @db.VarChar(50)
  deliveryError String?   @map("delivery_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
  @@schema("platform")
}

model ContentFeedback {
